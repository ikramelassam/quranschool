# Copier ce fichier vers .env et renseigner les vraies valeurs.
# .env ne doit JAMAIS être commité (voir .gitignore).

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Nécessaire pour que les formulaires (POST) fonctionnent une fois servi en
# HTTPS derrière Render — même noms de domaine qu'ALLOWED_HOSTS mais avec le
# schéma complet (https://), séparés par des virgules sans espace.
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (Supabase en production) — format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/quran_school_db

# Cloudinary (stockage des fichiers uploadés : logo, audio des candidatures profs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (mot de passe temporaire envoyé aux comptes validés)
# Par défaut (dev) : backend console, aucun envoi réel.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@zidni-ilman.local

# Notification Telegram au مدير/مشرف (nouvelle candidature élève/prof, paiement
# soumis, mot de passe oublié). Diffusée à TOUS les abonnés actifs (voir
# telegram_bot.AbonneTelegram, dashboard "اشتراكات إشعارات تيليجرام") — chacun
# s'abonne lui-même en envoyant /start au bot, puis est validé depuis le
# dashboard par un مدير/مشرف.
# TELEGRAM_BOT_TOKEN : token du bot, à obtenir auprès de @BotFather sur Telegram.
# Si absent, tout envoi Telegram est silencieusement ignoré (aucune erreur).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID : ancien système à chat_id unique, conservé UNIQUEMENT pour
# la migration de données telegram_bot 0002 (seed du 1er abonné actif lors du
# passage au nouveau système) — peut rester vide sur une install neuve.
TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET : secret arbitraire fourni à Telegram via `setWebhook`
# (voir telegram_bot.management.commands.set_telegram_webhook) — SEULE protection
# du webhook /telegram/webhook/. Générer avec :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
